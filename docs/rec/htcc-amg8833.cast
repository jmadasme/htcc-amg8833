[52.617, "o", "\u001b[90m┌─ Constantes de payload y downlink ────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[52.617, "o", "\u001b[90m  89\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine PAYLOAD_LEN_FULL     133       \u001b[39;49;00m\u001b[90m/* payload completo (solo SF7) */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[52.672, "o", "\u001b[90m  90\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine PAYLOAD_LEN_COMPACT  14        \u001b[39;49;00m\u001b[90m/* payload compacto (SF8..SF9) */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[52.727, "o", "\u001b[90m  91\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine DL_CMD_SF            0x01      \u001b[39;49;00m\u001b[90m/* downlink: <sf> 7..9 */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[52.782, "o", "\u001b[90m  92\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine DL_CMD_INTERVAL      0x02      \u001b[39;49;00m\u001b[90m/* downlink: <min_hi> <min_lo> BE */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[52.837, "o", "\u001b[90m  93\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine DL_CMD_QUERY_RSSI    0x03      \u001b[39;49;00m\u001b[90m/* downlink: <0x00> consulta de intensidad */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[52.892, "o", "\u001b[90m  94\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[52.947, "o", "\u001b[90m  95\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m/* Campos meta v2.1 (SIEMPRE presentes en TODO payload):\u001b[39;49;00m\n"]
[53.002, "o", "\u001b[90m  96\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m   \u001b[39;49;00mSF\u001b[90m \u001b[39;49;00m(\u001b[94m1\u001b[39;49;00m\u001b[90m \u001b[39;49;00mB),\u001b[90m \u001b[39;49;00mintervalo\u001b[90m \u001b[39;49;00men\u001b[90m \u001b[39;49;00mminutos\u001b[90m \u001b[39;49;00m(\u001b[94m2\u001b[39;49;00m\u001b[90m \u001b[39;49;00mB\u001b[90m \u001b[39;49;00mBE),\u001b[90m \u001b[39;49;00mRSSI\u001b[90m \u001b[39;49;00mdel\u001b[90m \u001b[39;49;00múltimo\u001b[90m \u001b[39;49;00mdownlink\u001b[90m\u001b[39;49;00m\n"]
[53.057, "o", "\u001b[90m  97\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m   \u001b[39;49;00m(\u001b[94m2\u001b[39;49;00m\u001b[90m \u001b[39;49;00mB\u001b[90m \u001b[39;49;00mint16\u001b[90m \u001b[39;49;00mBE,\u001b[90m \u001b[39;49;00mdBm).\u001b[90m \u001b[39;49;00mRSSI\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0x8000\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(\u001b[94m-32768\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m=>\u001b[90m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33msin downlink reciente\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.\u001b[90m\u001b[39;49;00m\n"]
[53.112, "o", "\u001b[90m  98\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m\u001b[39;49;00m\n"]
[53.167, "o", "\u001b[90m  99\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m  \u001b[39;49;00m-\u001b[90m \u001b[39;49;00mPayload\u001b[90m \u001b[39;49;00mCOMPLETO\u001b[90m  \u001b[39;49;00m(SF7):\u001b[90m  \u001b[39;49;00mSF/intervalo/RSSI\u001b[90m \u001b[39;49;00mvan\u001b[90m \u001b[39;49;00mal\u001b[90m \u001b[39;49;00mfinal\u001b[90m \u001b[39;49;00m(índices\u001b[90m \u001b[39;49;00m\u001b[94m133.\u001b[39;49;00m\u001b[94m.137\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[53.222, "o", "\u001b[90m 100\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m                              \u001b[39;49;00mya\u001b[90m \u001b[39;49;00mque\u001b[90m \u001b[39;49;00mv1\u001b[90m \u001b[39;49;00mno\u001b[90m \u001b[39;49;00mlos\u001b[90m \u001b[39;49;00mincluía.\u001b[90m\u001b[39;49;00m\n"]
[53.277, "o", "\u001b[90m 101\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m  \u001b[39;49;00m-\u001b[90m \u001b[39;49;00mPayload\u001b[90m \u001b[39;49;00mCOMPACTO\u001b[90m \u001b[39;49;00m(SF8+):\u001b[90m  \u001b[39;49;00mSF\u001b[90m \u001b[39;49;00m[\u001b[94m11\u001b[39;49;00m]\u001b[90m \u001b[39;49;00me\u001b[90m \u001b[39;49;00mintervalo\u001b[90m \u001b[39;49;00m[\u001b[94m12\u001b[39;49;00m:\u001b[94m13\u001b[39;49;00m]\u001b[90m \u001b[39;49;00mYA\u001b[90m \u001b[39;49;00mvienen\u001b[90m \u001b[39;49;00mdel\u001b[90m \u001b[39;49;00mbyte\u001b[90m\u001b[39;49;00m\n"]
[53.332, "o", "\u001b[90m 102\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m                              \u001b[39;49;00mlayout\u001b[90m \u001b[39;49;00mde\u001b[90m \u001b[39;49;00mv1;\u001b[90m \u001b[39;49;00msolo\u001b[90m \u001b[39;49;00mse\u001b[90m \u001b[39;49;00mAÑADE\u001b[90m \u001b[39;49;00mel\u001b[90m \u001b[39;49;00mRSSI\u001b[90m \u001b[39;49;00m[\u001b[94m14\u001b[39;49;00m:\u001b[94m15\u001b[39;49;00m].\u001b[90m\u001b[39;49;00m\n"]
[53.387, "o", "\u001b[90m 103\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m                              \u001b[39;49;00m(rediseñado\u001b[90m \u001b[39;49;00mv2\u001b[94m.1\u001b[39;49;00m\u001b[90m \u001b[39;49;00msin\u001b[90m \u001b[39;49;00mduplicar\u001b[90m \u001b[39;49;00mSF/intervalo).\u001b[90m \u001b[39;49;00m*/\u001b[90m\u001b[39;49;00m\n"]
[53.442, "o", "\u001b[90m 104\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine ADDON_SF_IDX_FULL     133\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
