[38.405, "o", "\u001b[90m┌─ Registros del AMG8833 y control VEXT ────────────────────────────────────────────────────────────────\u001b[0m\n"]
[38.405, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_ADDR         0x69      \u001b[39;49;00m\u001b[90m/* 0x68 si el puente Addr está soldado */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.46, "o", "\u001b[90m  71\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_ADDR_ALT     0x68      \u001b[39;49;00m\u001b[90m/* alternativa si 0x69 no responde     */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.515, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_REG_PCTL     0x00      \u001b[39;49;00m\u001b[90m/* Power Control Register             */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.57, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_REG_RESET    0x01      \u001b[39;49;00m\u001b[90m/* Reset Register                     */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.625, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_RESET_INITIAL 0x3F     \u001b[39;49;00m\u001b[90m/* Initial reset (arranque)           */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.68, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_REG_FPSC     0x04      \u001b[39;49;00m\u001b[90m/* Frame Rate Register                */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.735, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_REG_THERM    0x0E      \u001b[39;49;00m\u001b[90m/* Termistor (2 bytes, 12-bit signed) */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.79, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_REG_PIXELS   0x80      \u001b[39;49;00m\u001b[90m/* 64 píxeles (128 bytes)             */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.845, "o", "\u001b[90m  78\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine AMG8833_FPS_10       0x05      \u001b[39;49;00m\u001b[90m/* 10 fps                             */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[38.9, "o", "\u001b[90m  79\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[38.955, "o", "\u001b[90m  80\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m/* Alimentación conmutada del sensor: pad VEXT (P3_2).\u001b[39;49;00m\n"]
